# ── Banco do Max (Neon) ──────────────────────────────────────────────────
# Use a connection string POOLED do Neon: em serverless cada instância abre
# conexão própria e a direta estoura o limite.
DATABASE_URL=postgres://user:pass@ep-xxx-pooler.sa-east-1.aws.neon.tech/maxagent?sslmode=require

# Opcional. Depois do primeiro deploy com as tabelas do checkpointer criadas,
# =0 pula o DDL idempotente que roda a cada cold start.
# MAX_CHECKPOINTER_SETUP=0

# ── Contrato com o ImobPro ───────────────────────────────────────────────
# MESMO valor do MAX_NOTIFY_SECRET do Contractmaker. Assina /notify e
# /api/admin/status. Gere com: openssl rand -hex 32
#
# ATENÇÃO AO ROTACIONAR: dele também sai a chave do pseudônimo de telefone no
# log (`phoneTag`, com separação de domínio). Trocar este valor RENOMEIA todo
# mundo no log — uma investigação em curso não atravessa a rotação, e rótulos
# de antes e depois da troca não se casam. Rotacione com isso em mente, e use
# `npx tsx scripts/tel.ts <telefone>` com o segredo NOVO para achar o rótulo
# novo.
MAX_NOTIFY_SECRET=

# Cifra os tokens de API por org guardados em `org_config`.
# Gere com: openssl rand -base64 32
MAX_ENCRYPTION_KEY=

# ── Z-API ────────────────────────────────────────────────────────────────
# Instância PRÓPRIA do Max — não a do Newton. Uma instância = um número.
ZAPI_INSTANCE_ID=
ZAPI_INSTANCE_TOKEN=
ZAPI_CLIENT_TOKEN=
# Vai no PATH do webhook, então É credencial: /api/zapi-webhook/<secret>
ZAPI_WEBHOOK_SECRET=

# ── Cron ─────────────────────────────────────────────────────────────────
# A Vercel manda `Authorization: Bearer $CRON_SECRET` nos crons dela.
CRON_SECRET=

# ── LLM (OpenRouter) ─────────────────────────────────────────────────────
# Sem a chave, todo turn devolve o texto genérico de erro — o serviço sobe
# mas não conversa. A conta é compartilhada com o Newton; o gasto do Max é
# separado pelo header HTTP-Referer/X-Title (src/lib/llm.ts).
OPENROUTER_API_KEY=
# Opcional. Default: openai/gpt-5.4-nano (src/lib/llm.ts). Deixe COMENTADA se
# não for usar: vazia ela sobrescreve o default (?? não pega string vazia) e
# toda chamada de modelo falha.
# MAX_MODEL=

# ── ImobPro ──────────────────────────────────────────────────────────────
CONTRACTMAKER_API_URL=https://imobpro.ia.br

# ── Reconciliação de entrega (Fase 4) ────────────────────────────────────
# Assina o POST /api/webhooks/max no Contractmaker (desfecho de entrega).
# Secret PRÓPRIO, não reutilize o MAX_NOTIFY_SECRET: um autentica o
# Contractmaker falando com o Max, o outro o Max falando com o Contractmaker.
# Ausente = report desligado (estado normal até a rota existir lá).
# Gere com: openssl rand -hex 32
MAX_WEBHOOK_SECRET=

# ── Auditoria de conversa ────────────────────────────────────────────────
# Turn mais velho que N dias tem o TEXTO apagado; as métricas (custo, tokens,
# tools, latência) ficam. Default: 90.
# CONVERSATION_TTL_DAYS=90
# CONVERSATION_TTL_DAYS=off desliga a poda de propósito; valor inválido cai no
# default com log de erro, nunca desliga em silêncio.

# ── Memória (Fase 4) ─────────────────────────────────────────────────────
# Fato que ninguém atualiza há N dias é podado pelo cron. Default: 180.
# MEMORY_TTL_DAYS=180
# MEMORY_TTL_DAYS=off desliga a poda de propósito; valor inválido cai no
# default com log de erro (nunca desliga em silêncio).
